{
  "name": "sync-md-multi",
  "version": "0.4.6",
  "description": "Sync multiple SuperProductivity projects with their own markdown files (bidirectional)",
  "author": "Fernando Pindado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/fpindado/sync-md-multi.git"
  },
  "scripts": {
    "watch": "node scripts/watch.js",
    "build": "node scripts/build.js",
    "deploy": "npm run build && node scripts/deploy.js",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "prettier": "prettier --write 'src/**/*.{ts,js,json}'",
    "prettier:check": "prettier --check 'src/**/*.{ts,js,json}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.3",
    "@super-productivity/plugin-api": "^1.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.33",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.12",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
