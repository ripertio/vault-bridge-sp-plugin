{
  "id": "vault-bridge",
  "manifestVersion": 1,
  "name": "Vault Bridge",
  "version": "0.5.0",
  "description": "Two-way bridge between Super Productivity and an Obsidian vault: project folders, daily notes and the Inbox",
  "author": "ripertio",
  "homepage": "https://github.com/ripertio/vault-bridge-sp-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/ripertio/vault-bridge-sp-plugin.git"
  },
  "minSupVersion": "10.0.0",
  "permissions": [
    "getTasks",
    "updateTask",
    "addTask",
    "deleteTask",
    "getAllProjects",
    "addProject",
    "deleteProject",
    "nodeExecution",
    "reorderTasks",
    "registerHook",
    "showSnack",
    "batchUpdateForProject"
  ],
  "nodeScriptConfig": {
    "timeout": 30000,
    "memoryLimit": "256MB"
  },
  "supportsIndexHtml": true,
  "iFrame": true,
  "isSkipMenuEntry": false,
  "hooks": ["anyTaskUpdate", "taskUpdate", "projectListUpdate", "action"],
  "icon": "icon.svg"
}
